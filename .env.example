# Salin jadi .env lalu isi dari TiDB Cloud (Connect -> General)
TIDB_HOST=gateway01.xxxxxx.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=xxxxxx.root
TIDB_PASSWORD=isi_password
TIDB_DATABASE=triatra_fresh

# Opsional: kalau diisi, upload hanya bisa dengan token ini
UPLOAD_TOKEN=
# Opsional: path sertifikat CA kalau koneksi TLS gagal
# TIDB_CA_PATH=/etc/ssl/certs/ca-certificates.crt
